# Generated by artcraft from an immutable upstream commit.
pkgname=@APP@
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc=@DESCRIPTION@
arch=('x86_64')
url=@URL@
provides=(@APP_ID@)
conflicts=('@APP@-bin' '@APP@-git' @APP_ID@)
license=('MIT' 'Apache-2.0'@FONT_LICENSE@)
depends=('glibc' 'gcc-libs' 'libxkbcommon' 'libxkbcommon-x11' 'wayland'
         'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxrandr' 'libglvnd'
         'vulkan-icd-loader' 'xdg-desktop-portal'@AUDIO@@PACKAGE_DEPENDENCY@)
makedepends=('rust' 'git' 'pkgconf' 'cmake' 'clang' 'nasm' 'desktop-file-utils' 'python')
optdepends=('vulkan-driver: hardware accelerated rendering')
options=('!lto' '!debug')
_commit=@SHA@
_font_commit=@FONT_SHA@
_upstream_version=@UPSTREAM_VERSION@
_build_date=@BUILD_DATE@
source=(@SOURCES@)
sha256sums=(@CHECKSUMS@)

_build_env() {
  export CARGO_TARGET_DIR="$startdir/.cache/target"
  export CARGO_HOME="$startdir/.cache/cargo"
  export CARGO_BUILD_JOBS="${ARTCRAFT_BUILD_JOBS:-2}"
  export CARGO_PROFILE_RELEASE_DEBUG=0
  # Avoid building for the runner CPU: the package must run on any x86_64 machine.
  export RUSTFLAGS='-C target-cpu=x86-64'
@UPDATER_ENV@
  export @ENV_PREFIX@_BUILD_SHA="$_commit"
  export @ENV_PREFIX@_BUILD_DATE="$_build_date"
  export @ENV_PREFIX@_VERSION="$_upstream_version"
  if [[ -n "$_font_commit" ]]; then
    export CRAFT_FONTS_DIR="$srcdir/craft-fonts-$_font_commit"
    export CRAFT_FONTS_REQUIRED=1
  fi
}

build() {
  cd "$srcdir/@SOURCE_DIR@-$_commit"
  _build_env
@UPDATER_PATCH@
  cargo build --release --locked @CARGO_PACKAGES@@FEATURES@
}

check() {
  cd "$srcdir/@SOURCE_DIR@-$_commit"
  _build_env
@CLI_CHECK@
  local app_id=@APP_ID@
  desktop-file-validate "packaging/linux/$app_id.desktop"
}

package() {
  cd "$srcdir/@SOURCE_DIR@-$_commit"
  _build_env
  local app_id=@APP_ID@ file font size icon
  install -Dm755 "$CARGO_TARGET_DIR/release/@BINARY@" "$pkgdir/usr/bin/$pkgname"
@CLI_INSTALL@
  install -Dm644 "packaging/linux/$app_id.desktop" "$pkgdir/usr/share/applications/$app_id.desktop"
  install -d "$pkgdir/usr/share/metainfo" "$pkgdir/usr/share/icons"
  sed -e "s/@VERSION@/$_upstream_version/g" -e "s/@DATE@/$_build_date/g" \
    "packaging/linux/$app_id.metainfo.xml" > "$pkgdir/usr/share/metainfo/$app_id.metainfo.xml"
  while read -r size icon; do
    install -Dm644 "assets/app-icon/icon.iconset/$icon" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$app_id.png"
  done <<'ICONS'
16 icon_16x16.png
32 icon_32x32.png
64 icon_32x32@2x.png
128 icon_128x128.png
256 icon_256x256.png
512 icon_512x512.png
1024 icon_512x512@2x.png
ICONS
  for file in LICENSE LICENSE-MIT LICENSE-APACHE NOTICE COPYRIGHT DISCLAIMER.md ATTRIBUTION.md THIRD-PARTY-LICENSES.txt; do
    [[ ! -f "$file" ]] || install -Dm644 "$file" "$pkgdir/usr/share/licenses/$pkgname/$file"
  done
  [[ ! -f README.md ]] || install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  if [[ -n "$_font_commit" ]]; then
    for font in "$CRAFT_FONTS_DIR"/fonts/*/OFL.txt; do
      [[ ! -f "$font" ]] || install -Dm644 "$font" \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-$(basename "$(dirname "$font")").txt"
    done
  fi
}
